{
  "buildCommand": "npx prisma generate && next build",
  "regions": ["bom1"],
  "functions": {
    "src/app/**/*": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/api/**/*": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "*/10 * * * *"
    }
  ]
}
